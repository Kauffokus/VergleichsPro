function openAdmin(){$("modalContent").innerHTML=`<button class="iconbtn close" onclick="closeModal()" aria-label="Schließen">✕</button><h2>Datenverwaltung – Demo</h2><p>Der lokale Prototyp kann einen neuen Datensatz im Browser hinzufügen. Für den produktiven Adminbereich braucht es serverseitige Anmeldung, Datenbank, Rechte und Audit-Logs.</p><div class="adminfields"><label>Produktname<input id="newName" placeholder="z. B. Modellname"></label><label>Marke<input id="newBrand" placeholder="Hersteller"></label><label>Kategorie<select id="newCategory">${categories.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join("")}</select></label><label>Produkt-URL / Quelle<input id="newSource" type="url" placeholder="https://…"></label><button class="btn primary" onclick="addDemoProduct()">Lokalen Entwurf hinzufügen</button><p class="fineprint">Dieser Entwurf bleibt nur im aktuellen Browser-Speicher der Seite und wird nicht veröffentlicht oder an einen Server gesendet.</p></div>`;$("modal").classList.add("open")}
function addDemoProduct(){const name=$("newName").value.trim(),brand=$("newBrand").value.trim(),cat=$("newCategory").value,source=$("newSource").value.trim();if(!name||!brand){toast("Bitte Produktname und Marke ausfüllen.");return}if(source&&!/^https?:\/\//i.test(source)){toast("Bitte eine gültige http(s)-Quellen-URL eintragen.");return}const p={id:"local-"+Date.now(),name,brand,categoryId:cat,price:null,score:null,status:"draft",image:imagePool[categories.findIndex(c=>c.id===cat)%imagePool.length],specs:{"Datenstatus":"Lokaler Entwurf – Datenprüfung erforderlich",...(source?{"Quelle":source}:{})},badge:"Lokaler Entwurf"};products.unshift(p);closeModal();activeCategory=cat;renderCategories();renderProducts();toast("Lokaler Entwurf hinzugefügt – noch nicht veröffentlicht.");$("produkte").scrollIntoView({behavior:"smooth"})}

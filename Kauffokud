let activeCategory="all", sortMode="recommended", selected=[], popularOnly=false;
const $=id=>document.getElementById(id);
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function toast(msg){$("toast").textContent=msg;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),2600)}
function renderCategories(){
 const q=$("categorySearch").value.toLowerCase().trim();
 const list=categories.filter(c=>c.name.toLowerCase().includes(q)&&(!popularOnly||c.index<12));
 $("catGrid").innerHTML=list.map(c=>`<button class="cat ${activeCategory===c.id?'active':''}" onclick="setCategory('${c.id}')"><span class="caticon">${c.icon}</span><span><strong>${esc(c.name)}</strong><small>10 Produktplätze</small></span></button>`).join("");
 $("categoryCount").textContent=`${list.length} von ${categories.length} Kategorien`;
}
function setCategory(id){activeCategory=id;popularOnly=false;document.querySelectorAll(".pill[data-filter]").forEach(b=>b.classList.toggle("active",b.dataset.filter===(id==="all"?"all":"")));renderCategories();renderProducts();if(id!=="all"){$("productHeading").textContent=categories.find(c=>c.id===id)?.name||"Produkte"}else $("productHeading").textContent="Entdecke Produkte";$("produkte").scrollIntoView({behavior:"smooth",block:"start"})}
function showPopular(){popularOnly=!popularOnly;document.querySelectorAll(".pill[data-filter]").forEach(b=>b.classList.toggle("active",b.dataset.filter==="popular"&&popularOnly));renderCategories()}
function runSearch(){const q=$("mainSearch").value.toLowerCase().trim();if(!q)return;const cat=categories.find(c=>c.name.toLowerCase().includes(q)||c.id.includes(q));if(cat){setCategory(cat.id)}else{activeCategory="all";renderProducts();$("produkte").scrollIntoView({behavior:"smooth"});toast("Suche angewendet. Verifizierte Produktdaten sind im Demo-Datensatz noch begrenzt.")}}
$("mainSearch").addEventListener("keydown",e=>{if(e.key==="Enter")runSearch()});
function setSort(mode,el){sortMode=mode;document.querySelectorAll("#productFilters .pill").forEach(b=>b.classList.remove("active"));el.classList.add("active");renderProducts()}
function renderProducts(){
 const q=$("mainSearch").value.toLowerCase().trim(), max=$("priceFilter").value;
 let list=products.filter(p=>(activeCategory==="all"||p.categoryId===activeCategory)&&(!q||`${p.name} ${p.brand} ${p.categoryId}`.toLowerCase().includes(q))&&(max==="all"||(p.price!==null&&p.price<=Number(max))));
 if(sortMode==="score")list.sort((a,b)=>(b.score??-1)-(a.score??-1));
 if(sortMode==="price")list.sort((a,b)=>(a.price??Infinity)-(b.price??Infinity));
 if(sortMode==="recommended")list.sort((a,b)=>(a.status==="published"?0:1)-(b.status==="published"?0:1));
 $("resultCount").textContent=`${list.length} Einträge`;
 $("productGrid").innerHTML=list.slice(0,60).map(p=>`<article class="product"><div class="productimg"><img src="${esc(p.image)}" alt="Illustratives Technikbild für ${esc(p.name)}" loading="lazy" onerror="this.style.display='none'"><span class="tag">${esc(p.badge||"Demo")}</span></div><div class="productbody"><div class="brandname">${esc(p.brand)}</div><h3>${esc(p.name)}</h3><div class="specmini">${Object.entries(p.specs||{}).slice(0,2).map(([k,v])=>`<span>${esc(k)}: ${esc(v)}</span>`).join("")}</div><div class="scoreline"><div class="score"><div class="scorebubble">${p.score===null?"—":p.score}</div><div><div class="scorelabel">Kauffokus-Score</div><div class="fineprint">${p.score===null?"Nicht bewertet":"von 100 Punkten"}</div></div></div><div class="price">${p.price===null?"Preis offen":p.price.toLocaleString("de-DE",{style:"currency",currency:"EUR"})}</div></div><div class="productactions"><button class="btn" onclick="toggleCompare('${p.id}')">${selected.includes(p.id)?"✓ Ausgewählt":"+ Vergleichen"}</button><button class="btn" onclick="productDetails('${p.id}')">Details ↗</button></div></div></article>`).join("")||`<div class="empty">Keine Einträge gefunden. Ändere deine Suche oder wähle eine andere Kategorie.</div>`;
 if(list.length>60)$("productGrid").insertAdjacentHTML("beforeend",`<div class="empty">Es gibt ${list.length} Einträge. Verfeinere die Suche, um die Treffer einzugrenzen.</div>`);
}
function toggleCompare(id){if(selected.includes(id))selected=selected.filter(x=>x!==id);else if(selected.length<4)selected.push(id);else{toast("Maximal vier Produkte gleichzeitig vergleichen.");return}updateCompareBar();renderProducts()}
function updateCompareBar(){$("compareBar").classList.toggle("hidden",selected.length===0);$("compareTitle").textContent=selected.length===1?"1 Produkt ausgewählt":`${selected.length} Produkte ausgewählt`;$("compareSub").textContent=`${selected.length} von 4 Produkten gewählt`;}
function clearCompare(){selected=[];updateCompareBar();renderProducts();toast("Vergleich geleert.")}
function openCompare(){if(!selected.length){toast("Wähle zuerst mindestens ein Produkt aus.");$("produkte").scrollIntoView({behavior:"smooth"});return}const chosen=selected.map(id=>products.find(p=>p.id===id)).filter(Boolean);const same=chosen.every(p=>p.categoryId===chosen[0].categoryId);let rows=[["Marke",p=>p.brand],["Produkt",p=>p.name],["Kategorie",p=>categories.find(c=>c.id===p.categoryId)?.name],["Preis",p=>p.price===null?"Nicht verfügbar":p.price.toLocaleString("de-DE",{style:"currency",currency:"EUR"})],["Kauffokus-Score",p=>p.score===null?"Noch nicht bewertet":`${p.score}/100`],["Datenstatus",p=>p.status==="published"?"Veröffentlicht":"Nicht verifiziert"]];
 if(same){const keys=[...new Set(chosen.flatMap(p=>Object.keys(p.specs||{})))];keys.forEach(k=>rows.push([k,p=>p.specs?.[k]??"Keine Angabe"]))}
 $("compareContent").innerHTML=!same?`<div class="empty">Diese Produkte gehören zu unterschiedlichen Kategorien. Für einen fachlich sinnvollen Vergleich wähle Produkte derselben Kategorie.</div>`:`<div class="tablewrap"><table class="comparetable"><thead><tr><th>Merkmal</th>${chosen.map(p=>`<th>${esc(p.brand)}<br>${esc(p.name)}</th>`).join("")}</tr></thead><tbody>${rows.map(([label,get])=>`<tr><td>${esc(label)}</td>${chosen.map(p=>`<td>${esc(get(p))}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
 $("compareOverlay").classList.add("open");document.body.style.overflow="hidden"}
function closeCompare(){$("compareOverlay").classList.remove("open");document.body.style.overflow=""}
function productDetails(id){const p=products.find(x=>x.id===id);if(!p)return;const cat=categories.find(c=>c.id===p.categoryId);$("modalContent").innerHTML=`<button class="iconbtn close" onclick="closeModal()" aria-label="Schließen">✕</button><div class="eyebrow">${esc(cat?.name||"Produkt")}</div><h2>${esc(p.brand)} ${esc(p.name)}</h2><p>Dieser Eintrag ist Teil des Kauffokus-Datenprototyps. Er darf erst nach Prüfung der exakten Modellvariante, der technischen Spezifikationen, der Bildrechte und der Quellen veröffentlicht werden.</p><div class="tablewrap"><table class="comparetable"><tbody><tr><td>Datenstatus</td><td>${esc(p.status)}</td></tr><tr><td>Preis</td><td>${p.price===null?"Noch nicht verifiziert":esc(p.price)}</td></tr><tr><td>Score</td><td>${p.score===null?"Noch nicht bewertet":esc(p.score)}</td></tr>${Object.entries(p.specs||{}).map(([k,v])=>`<tr><td>${esc(k)}</td><td>${esc(v)}</td></tr>`).join("")}</tbody></table></div><p class="fineprint">Demo ohne Händlerangebote oder Affiliate-Link. Es werden keine unbestätigten Kaufpreise angezeigt.</p><button class="btn primary" onclick="toggleCompare('${p.id}');closeModal()">Zum Vergleich hinzufügen</button>`;$("modal").classList.add("open")}
function closeModal(){$("modal").classList.remove("open")}
function showLegal(which){let title,body;if(which==="impressum"){title="Impressum – auszufüllende Vorlage";body=`<p><strong>Wichtig:</strong> Diese Vorlage ist nicht veröffentlichungsfertig. Ersetze sämtliche Angaben durch echte Angaben des Betreibers und lasse die Pflichten für dein Geschäftsmodell prüfen.</p><ul><li>Vollständiger Name/Firma und Rechtsform</li><li>Ladungsfähige Anschrift</li><li>E-Mail und weitere gesetzlich erforderliche Kontaktangaben</li><li>Register, Registernummer, Umsatzsteuer-ID oder Aufsichtsangaben, sofern einschlägig</li></ul><p>Rechtsgrundlage und Anforderungen müssen anhand des tatsächlichen Betriebs geprüft werden.</p>`}else if(which==="datenschutz"){title="Datenschutzerklärung – noch zu erstellen";body=`<p>Eine fertige Datenschutzerklärung kann ohne Kenntnis der tatsächlich eingesetzten Dienste nicht seriös erstellt werden.</p><ul><li>Verantwortlicher und Kontakt</li><li>Hosting, Server-Logs und Speicherdauer</li><li>Formulare, Nutzerkonten und Kontaktaufnahme</li><li>Affiliate-Netzwerke und Weiterleitungen</li><li>Analyse-, Marketing- und Consent-Technologien</li><li>Rechtsgrundlagen, Empfänger und Betroffenenrechte</li></ul><p>Die finale Erklärung muss die realen Datenflüsse korrekt beschreiben.</p>`}else{title="Werbe- und Affiliate-Hinweis";body=`<p>Bei Affiliate-Links kann der Betreiber eine Provision erhalten, wenn über einen Link ein Kauf zustande kommt. Für Nutzer entstehen dadurch grundsätzlich keine zusätzlichen Kosten. Die Bewertung soll nach dokumentierten Kriterien erfolgen und nicht allein von der Provision abhängen.</p><p>Vor dem Livegang müssen die tatsächlichen Partner, Kennzeichnungen und Vertragsbedingungen ergänzt werden.</p>`}$("modalContent").innerHTML=`<button class="iconbtn close" onclick="closeModal()" aria-label="Schließen">✕</button><h2>${title}</h2>${body}<button class="btn primary" onclick="closeModal()">Schließen</button>`;$("modal").classList.add("open")}
